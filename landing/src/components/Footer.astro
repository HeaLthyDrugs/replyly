---
// Footer.astro - Clean structured footer with multi-column links and giant brand wordmark
---

<footer class="bg-surface-muted/30 pt-16 pb-12 overflow-hidden">
  <div class="px-6 sm:px-10">
    <!-- Top Row: Columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 pb-16 border-b border-border-subtle text-sm">
      <!-- Col 1: Brand Info -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <img src="/logo.svg" alt="Replyly" class="w-6 h-6 rounded" />
          <span class="font-semibold tracking-normal text-ink text-base">replyly</span>
        </a>
        <p class="text-xs leading-relaxed text-ink-muted">
          Contextual, privacy-first AI replies for modern social feeds. 100% client-side, zero tracking.
        </p>
        <div class="mt-4 text-xs font-mono text-ink-muted">
          Manifest V3 Ready
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-ink font-semibold mb-4">
          Product
        </h4>
        <ul class="space-y-2.5 text-xs font-medium text-ink-secondary">
          <li><a href="/#features" class="hover:text-ink transition-colors">Features</a></li>
          <li><a href="/#architecture" class="hover:text-ink transition-colors">Architecture & BYOK</a></li>
          <li><a href="/#demo" class="hover:text-ink transition-colors">Interactive Preview</a></li>
          <li><a href="/changelog" class="hover:text-ink transition-colors">Changelog</a></li>
          <li><a href="/#faq" class="hover:text-ink transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-ink font-semibold mb-4">
          Resources
        </h4>
        <ul class="space-y-2.5 text-xs font-medium text-ink-secondary">
          <li>
            <a
              href="https://github.com/HeaLthyDrugs/replyly/releases"
              target="_blank"
              rel="noreferrer"
              class="hover:text-ink transition-colors"
            >
              GitHub Releases
            </a>
          </li>
          <li>
            <a
              href="https://github.com/HeaLthyDrugs/replyly"
              target="_blank"
              rel="noreferrer"
              class="hover:text-ink transition-colors"
            >
              Source Repository
            </a>
          </li>
          <li>
            <a
              href="https://aistudio.google.com/"
              target="_blank"
              rel="noreferrer"
              class="hover:text-ink transition-colors"
            >
              Google AI Studio
            </a>
          </li>
          <li>
            <a
              href="https://console.groq.com/"
              target="_blank"
              rel="noreferrer"
              class="hover:text-ink transition-colors"
            >
              Groq Cloud Console
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Legal & Compliance -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-ink font-semibold mb-4">
          Compliance
        </h4>
        <ul class="space-y-2.5 text-xs font-medium text-ink-secondary">
          <li><a href="/privacy" class="hover:text-ink transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-ink transition-colors">Terms of Service</a></li>
          <li>
            <a
              href="https://github.com/HeaLthyDrugs/replyly/blob/main/LICENSE"
              target="_blank"
              rel="noreferrer"
              class="hover:text-ink transition-colors"
            >
              MIT License
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Meta Row -->
    <div class="pt-8 pb-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-ink-muted">
      <span>© {new Date().getFullYear()} Replyly. Built for thoughtful conversations.</span>
      <span>Designed with high-contrast minimalism.</span>
    </div>

    <!-- Giant Typographic Wordmark (Kobbe style) -->
    <div class="pt-4 select-none pointer-events-none text-center">
      <span class="text-[18vw] leading-none font-bold tracking-tighter text-border-subtle/80 block font-sans">
        replyly
      </span>
    </div>
  </div>
</footer>
