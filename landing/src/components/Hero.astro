---
// Hero.astro - Responsive editorial typography hero
---

<section class="relative py-12 sm:py-20 md:py-28 border-b border-border-subtle">
  <div class="px-4 sm:px-8 md:px-10">
    <!-- Editorial Headline Block -->
    <div class="max-w-5xl">
      <!-- Direct Unboxed Category Text -->
      <div class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-4 sm:mb-6 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-coral flex-shrink-0"></span>
        <span>Local-First Social AI</span>
      </div>

      <!-- Breathable Headline with Comfortable Letter Spacing and Line Height across all breakpoints -->
      <h1 class="text-2xl xs:text-3xl sm:text-5xl md:text-[54px] font-medium tracking-normal text-ink leading-[1.3] sm:leading-[1.22]">
        <span class="font-semibold text-ink">Thoughtful replies deserve real context.</span>
        <span class="text-ink-muted font-normal block sm:inline mt-2 sm:mt-0">
          At Replyly, we bring intelligence straight to your feed: craft contextual replies on X and LinkedIn using your own AI models — with no subscriptions, no tracking, and zero telemetry.
        </span>
      </h1>
    </div>

    <!-- Actions & Direct Micro-Specs Row -->
    <div class="mt-8 sm:mt-14 md:mt-16 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-5 pt-6 sm:pt-8 border-t border-border-subtle">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
        <a
          href="https://github.com/HeaLthyDrugs/replyly/releases/latest"
          target="_blank"
          rel="noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3 rounded-full bg-ink text-ink-inverse text-sm font-medium hover:bg-neutral-800 active:scale-[0.98] transition-all shadow-sm group text-center"
        >
          <span>Install Extension</span>
          <svg
            class="w-4 h-4 text-neutral-400 group-hover:translate-x-0.5 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="#architecture"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-surface-muted hover:bg-surface-subtle border border-border-subtle text-ink text-sm font-medium transition-all text-center"
        >
          <span>See How It Works</span>
        </a>
      </div>

      <!-- Direct Unboxed Monospace Tabular Specs (Responsive wraps cleanly) -->
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 sm:gap-x-5 text-xs font-mono text-ink-muted sm:ml-auto pt-2 sm:pt-0">
        <div class="inline-flex items-center gap-1.5 text-ink-secondary">
          <span class="text-emerald-600 font-bold">✓</span>
          <span>100% Client-Side</span>
        </div>
        <span class="hidden sm:inline text-border-strong">•</span>
        <div class="inline-flex items-center gap-1.5 text-ink-secondary">
          <span class="text-emerald-600 font-bold">✓</span>
          <span>BYOK</span>
        </div>
        <span class="hidden sm:inline text-border-strong">•</span>
        <div class="inline-flex items-center gap-1.5 text-ink-secondary">
          <span class="text-emerald-600 font-bold">✓</span>
          <span>0 Trackers</span>
        </div>
      </div>
    </div>
  </div>
</section>
