---
// FAQSection.astro - Clean responsive horizontal accordion FAQ
const faqs = [
  {
    q: "Is Replyly really free to use?",
    a: "Yes, Replyly is 100% free and open-source under the MIT license. There are no monthly subscription fees, paywalls, or feature tiers. Because you use your own API keys (Google Gemini, Groq, or OpenRouter), you only pay direct provider token costs—which are often completely free (Google AI Studio free tier) or just fractions of a cent per month.",
  },
  {
    q: "Where are my API keys stored and how safe are they?",
    a: "Your API keys are saved exclusively in your browser's private `chrome.storage.local` sandbox. They are never sent to any Replyly server (we don't operate any backend servers) and only leave your machine over direct, encrypted HTTPS requests to official provider API endpoints (e.g. generativelanguage.googleapis.com, api.groq.com, or openrouter.ai).",
  },
  {
    q: "Which browsers are supported?",
    a: "Replyly is built on Chrome Manifest V3 standards and runs seamlessly on Google Chrome, Brave, Arc, Microsoft Edge, Vivaldi, and any Chromium-based browser.",
  },
  {
    q: "How does Replyly extract post context?",
    a: "When you click the Replyly icon on an X (Twitter) or LinkedIn post, a lightweight client script inspects the active DOM elements around the post—extracting author information, main text content, and thread context. This context is packaged into the prompt payload sent directly to your configured AI model.",
  },
  {
    q: "Can I customize the reply tones and system prompts?",
    a: "Absolutely. In addition to built-in presets (Professional, Casual, Witty), you can specify custom prompt instructions in the Replyly Options page. You can instruct the AI to follow your specific formatting rules, avoid cliches, speak from a specific persona, or reply in other languages.",
  },
  {
    q: "How do I install Replyly from GitHub Releases?",
    a: "Download the latest `chrome-mv3-prod.zip` from our GitHub Releases page and unzip it. Next, navigate to chrome://extensions in your browser, enable 'Developer mode' in the top-right corner, click 'Load unpacked', and select the unzipped folder. Replyly is ready instantly.",
  },
];
---

<section id="faq" class="py-12 sm:py-20 md:py-24 border-b border-border-subtle">
  <div class="px-4 sm:px-8 md:px-10">
    <!-- Header Block -->
    <div class="max-w-3xl mb-8 sm:mb-12">
      <div class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-2">
        QUESTIONS & ANSWERS
      </div>
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-semibold tracking-normal text-ink leading-tight">
        Frequently Asked Questions
      </h2>
      <p class="mt-4 text-sm sm:text-base md:text-lg text-ink-muted leading-relaxed">
        Everything you need to know about Replyly's architecture, security, and setup.
      </p>
    </div>

    <!-- Accordion List (Responsive) -->
    <div class="max-w-4xl divide-y divide-border-subtle border-y border-border-subtle">
      {
        faqs.map((faq, index) => (
          <details class="group py-5 sm:py-6 cursor-pointer transition-all">
            <summary class="flex items-start sm:items-center justify-between gap-4 list-none select-none text-left">
              <div class="flex items-start gap-3 sm:gap-4">
                <span class="text-xs font-mono text-ink-muted tabular-nums pt-0.5 sm:pt-0 flex-shrink-0">
                  0{index + 1}
                </span>
                <span class="text-sm sm:text-base md:text-lg font-medium text-ink group-hover:text-ink-secondary transition-colors">
                  {faq.q}
                </span>
              </div>
              <span class="text-ink-muted group-open:rotate-180 transition-transform duration-200 flex-shrink-0 mt-0.5 sm:mt-0">
                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 sm:mt-4 pl-7 sm:pl-9 text-xs sm:text-sm md:text-base text-ink-secondary leading-relaxed max-w-3xl">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
