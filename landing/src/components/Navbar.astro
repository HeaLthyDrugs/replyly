---
// Navbar.astro - Clean unboxed header with direct text, structured navigation, and high-contrast CTA
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-canvas/90 border-b border-border-subtle transition-all">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 h-16 md:h-20 flex items-center justify-between">
    <!-- Left: Direct Brand Logo & Unboxed Version Text -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2.5 text-ink hover:opacity-80 transition-opacity">
        <img src="/logo.svg" alt="Replyly" class="w-6 h-6 rounded" />
        <span class="text-base font-semibold tracking-normal">replyly</span>
      </a>

      <span class="hidden sm:inline-block text-xs font-mono text-ink-muted pl-1">
        v0.0.1 MV3
      </span>
    </div>

    <!-- Center/Right: Desktop Navigation & High-Contrast CTA -->
    <div class="flex items-center gap-6 md:gap-8">
      <nav class="hidden md:flex items-center gap-6 text-sm text-ink-secondary">
        <a href="/#features" class="hover:text-ink transition-colors">Features</a>
        <a href="/#architecture" class="hover:text-ink transition-colors">Architecture</a>
        <a href="/#demo" class="hover:text-ink transition-colors">Preview</a>
        <a href="/changelog" class="hover:text-ink transition-colors">Changelog</a>
        <a href="/#faq" class="hover:text-ink transition-colors">FAQ</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="https://github.com/HeaLthyDrugs/replyly"
          target="_blank"
          rel="noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-ink-secondary hover:text-ink px-2 py-1 transition-colors"
          aria-label="GitHub Repository"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>

        <!-- High-Contrast Black Pill CTA -->
        <a
          href="https://github.com/HeaLthyDrugs/replyly/releases/latest"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full bg-ink text-ink-inverse text-sm font-medium hover:bg-neutral-800 active:scale-[0.98] transition-all shadow-sm group"
        >
          <span>Get Extension</span>
          <svg
            class="w-3.5 h-3.5 text-neutral-400 group-hover:translate-x-0.5 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
