---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<Layout title={`${title} — Replyly`} description={description}>
  <div class="max-w-6xl mx-auto border-x border-border-subtle min-h-screen bg-canvas flex flex-col">
    <!-- Minimal Top Header -->
    <header class="border-b border-border-subtle bg-canvas/90 backdrop-blur sticky top-0 z-40">
      <div class="px-6 sm:px-10 h-16 md:h-20 flex items-center justify-between">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-medium text-ink hover:text-ink-secondary transition-colors"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to Home</span>
        </a>

        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo.svg" alt="Replyly" class="w-6 h-6 rounded" />
          <span class="font-semibold text-base tracking-normal text-ink">replyly</span>
        </a>
      </div>
    </header>

    <!-- Legal Body Container -->
    <main class="flex-1 max-w-3xl w-full mx-auto px-6 sm:px-10 py-16 md:py-24">
      <div class="mb-12 border-b border-border-subtle pb-8">
        <div class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-3">
          <span>Legal Documentation • Updated {lastUpdated}</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-semibold tracking-normal text-ink leading-tight">
          {title}
        </h1>
        <p class="mt-4 text-base md:text-lg text-ink-muted leading-relaxed">
          {description}
        </p>
      </div>

      <article class="space-y-10 text-[15px] leading-relaxed text-ink-secondary">
        <slot />
      </article>
    </main>

    <!-- Legal Footer -->
    <footer class="border-t border-border-subtle py-10 bg-surface-muted/30">
      <div class="px-6 sm:px-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-ink-muted">
        <span>© {new Date().getFullYear()} Replyly. Open source under MIT.</span>
        <div class="flex items-center gap-6">
          <a href="/privacy" class="hover:text-ink transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-ink transition-colors">Terms of Service</a>
          <a href="/changelog" class="hover:text-ink transition-colors">Changelog</a>
          <a href="https://github.com/HeaLthyDrugs/replyly" target="_blank" rel="noreferrer" class="hover:text-ink transition-colors">GitHub</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
